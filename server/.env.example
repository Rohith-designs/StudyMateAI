# Server Configuration
PORT=5000
NODE_ENV=development

# Persistent PostgreSQL (Optional - system falls back to resilient local storage if empty)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studymate_db

# LLM Provider Configuration for Live Grounded RAG
# Leave blank to run in transparent DEMO MODE (sample grounded answers & sources)
# Provide a key below to activate LIVE AI MODE with real RAG retrieval:
GEMINI_API_KEY=
OPENAI_API_KEY=

# Institution Info
INSTITUTE_NAME=Prasad V. Potluri Siddhartha Institute of Technology
INSTITUTE_CODE=PVPSIT
DEFAULT_REGULATION=PVP20
